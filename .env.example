# TTS-Hub 密钥模板：复制为 .env 后填入真实密钥。
# .env 不进版本库；密钥只用于发请求，不写库、不进日志（错误信息统一脱敏）。

# MiniMax（国内站 https://platform.minimax.cn）
# 注意：调用复刻接口前需完成个人或企业实名认证，否则报 2038。
MINIMAX_API_KEY=

# 阶跃星辰（https://platform.stepfun.com）
STEPFUN_API_KEY=

# 智谱 AI（https://open.bigmodel.cn）
# 直接 Bearer 鉴权即可，不需要用 api_key 换 JWT。
ZHIPU_API_KEY=

# 阿里云百炼 / DashScope（https://bailian.console.aliyun.com）
# CosyVoice 系复刻创建音色免费，但要求样本是公网可访问免鉴权的 URL；
# 本地文件请用 target_model=qwen3-tts-vc-2026-01-22（走 base64 Data URL）。
DASHSCOPE_API_KEY=

# 百度智能云（https://console.bce.baidu.com/ai-engine/old/#/ai/speech/app/list）
# 需要**两把**密钥：API Key 用来换 access_token，Secret Key 是换取凭据。
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 云知声 Token Hub MaaS（https://maas.unisound.com）
# 注意：Token Plan 的 Key 与按量计费的 Key 是两套，不可互换。
UNISOUND_API_KEY=

# 腾讯云（https://console.cloud.tencent.com/cam/capi）
# 用 SecretId + SecretKey 做 TC3-HMAC-SHA256 签名；不是 API Key。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 火山引擎（https://console.volcengine.com/speech/app）
# 注意后付费音色首次合成即扣 138 元槽位费，见 docs/方案设计.md §11.5。
VOLCENGINE_API_KEY=

# 华为云 SIS（https://console.huaweicloud.com/iam/）
# 声音复刻走 IAM Token，因此这里填 IAM 用户名与登录密码，不是 AK/SK。
# 另需在 providers.yaml 里填 domain_name 与（可选的）project_id。
HUAWEI_USERNAME=
HUAWEI_PASSWORD=

# 科大讯飞开放平台（https://console.xfyun.cn/app/myapp）
# 三样都要：APPID 填进 providers.yaml，APIKey / APISecret 填这里。
# 合成只有 WebSocket，本 adapter 不实现合成。
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
